/*
 * wifi_secrets.h.example - template for your wifi creds
 * 
 * copy this to wifi_secrets.h and put in your actual passwords.
 * wifi_secrets.h is gitignored so it won't end up on github.
 */

#pragma once

typedef struct {
    const char *ssid;
    const char *password;
} wifi_cred_t;

/* put your networks here - the code tries them in order */
static const wifi_cred_t WIFI_CREDENTIALS[] = {
    {"YourHomeWiFi", "your_home_password"},
    {"YourOfficeWiFi", "your_office_password"},
    /* add as many as you want */
};

#define WIFI_CRED_COUNT (sizeof(WIFI_CREDENTIALS) / sizeof(WIFI_CREDENTIALS[0]))
